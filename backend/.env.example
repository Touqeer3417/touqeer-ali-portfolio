# Copy this file to .env and replace every placeholder.
OPENAI_API_KEY=replace_with_openai_api_key
EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

QDRANT_URL=https://replace-with-your-qdrant-cluster-url
QDRANT_API_KEY=replace_with_qdrant_api_key
COLLECTION=portfolio_kb
HYBRID_COLLECTION=portfolio_kb_hybrid

DENSE_TOP_K=10
BM25_TOP_K=10
RRF_LIMIT=5
RRF_K=2
TOP_K=5

# Use a random value with at least 24 characters.
# Must match RAG_API_SECRET in the Next.js/Vercel environment.
SHARED_SECRET=replace_with_a_random_secret_of_at_least_24_characters
